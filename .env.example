APP_NAME=Laravel
APP_KEY=
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# WAJIB DIUBAH SEBELUM DI-HOSTING
#
#   1. APP_KEY diisi lewat perintah `php artisan key:generate` DI SERVER,
#      jangan menyalin kunci dari komputer sendiri: siapa pun yang tahu
#      APP_KEY bisa memalsukan cookie dan sesi login.
#   2. APP_ENV=production  dan  APP_DEBUG=false. Dengan APP_DEBUG=true, setiap
#      galat menampilkan isi berkas .env, kueri dan nama berkas sumber.
#   3. APP_URL diisi alamat produksi, misalnya https://digipro-solution.com.
#   4. ADMIN_EMAILS diisi daftar email yang boleh masuk panel admin.
#   5. SESSION_SECURE_COOKIE=true (lihat bagian Session di bawah) dan
#      FORCE_HTTPS=true setelah sertifikat SSL terpasang.
#   6. LAJUKASIR_PREVIEW=false kalau halaman LajuKasir sudah dilayani dari
#      subdomainnya sendiri.
#   7. DB_USERNAME jangan root dan DB_PASSWORD jangan kosong.
#   8. LOG_LEVEL=warning, supaya berkas log tidak penuh dengan data pengunjung.
# ---------------------------------------------------------------------------

# Lingkungan aplikasi: local saat mengembangkan, production di server.
APP_ENV=local
APP_DEBUG=true

# Alamat kanonis situs untuk SEO (canonical, og:url, sitemap.xml, robots.txt).
# Isi dengan domain produksi, misalnya https://digipro-solution.com.
SITE_URL=https://digipro-solution.com

# Alamat halaman LajuKasir (subdomain) untuk tag canonical, sitemap.xml dan
# robots.txt halaman itu.
LAJUKASIR_HOST=lajukasir.digipro-solution.com
LAJUKASIR_URL=https://lajukasir.digipro-solution.com

# Alias http://lajukasir.localhost:8000 supaya halamannya bisa dibuka di
# komputer pengembang tanpa menyunting /etc/hosts. Kosongkan untuk mematikannya.
LAJUKASIR_LOCAL_HOST=lajukasir.localhost

# Alamat bantu /lajukasir-preview di domain utama. Matikan dengan false kalau
# halamannya sudah benar-benar dilayani dari subdomain.
LAJUKASIR_PREVIEW=true
LAJUKASIR_PREVIEW_PATH=lajukasir-preview

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Panel admin
# ---------------------------------------------------------------------------
# Daftar alamat email yang boleh membuka /admin, dipisah koma. Kosong berarti
# semua akun di tabel users boleh masuk, jadi isilah di server produksi.
ADMIN_EMAILS=

# Akun admin yang dibuat `php artisan db:seed` (lihat DatabaseSeeder).
# ADMIN_PASSWORD minimal 12 karakter. Kalau keduanya dikosongkan, seeder tidak
# membuat akun apa pun sehingga tidak pernah ada kata sandi bawaan.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Batas ukuran berkas yang boleh diunggah dari panel admin, dalam kilobyte.
MAX_UPLOAD_SIZE=8192

# ---------------------------------------------------------------------------
# HTTPS dan proxy
# ---------------------------------------------------------------------------
# FORCE_HTTPS=true setelah sertifikat SSL terpasang, supaya setiap alamat yang
# dibuat Laravel memakai https.
FORCE_HTTPS=false

# Alamat proxy/Cloudflare yang boleh dipercaya, dipisah koma. Isi hanya kalau
# hostingnya memang berada di belakang proxy; kalau tidak, alamat pengunjung
# tidak bisa dipalsukan lewat header X-Forwarded-For.
TRUSTED_PROXIES=

# Batas kunjungan per alamat IP per menit yang dicatat analitik. Halamannya
# tetap dilayani; hanya pencatatannya yang berhenti setelah batas ini.
ANALYTICS_MAX_VIEWS_PER_MINUTE=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Di produksi pakai "warning": dengan "debug" berkas log menyimpan data
# pengunjung dan jejak kode yang tidak diperlukan.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# SESSION_ENCRYPT=true menyimpan isi sesi dalam bentuk terenkripsi.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie sesi hanya dikirim lewat https. Isi true di produksi; biarkan kosong
# selama mengembangkan di http://localhost supaya login panel tetap bisa.
# SESSION_SECURE_COOKIE=true
# Same-site cookie "lax" sudah cukup: permintaan dari situs lain tidak ikut
# membawa cookie sesi, sehingga terhindar dari CSRF.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
